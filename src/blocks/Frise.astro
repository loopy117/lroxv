---
/** Frise chronologique : dates clés et palmarès (histoire du club, d'une association, d'une commune). */
import Section from '../components/Section.astro';
import Img from '../components/Img.astro';
const { background, spacing, id, surtitre, titre, intro, items = [] } = Astro.props;
---
<Section {background} {spacing} {id} {surtitre} {titre} {intro}>
  <ol class="fr">
    {items.map((it: any) => (
      <li class="fr__item">
        <p class="fr__annee">{it.annee}</p>
        <div class="fr__corps">
          <h3 class="fr__titre">{it.titre}</h3>
          {it.texte && <p class="fr__texte">{it.texte}</p>}
          {it.image && <div class="fr__image"><Img image={it.image} sizes="(min-width: 800px) 420px, 90vw" largeurs={[480, 800]} /></div>}
        </div>
      </li>
    ))}
  </ol>
</Section>
<style>
  .fr { list-style: none; margin: 0; padding: 0; position: relative; display: flex; flex-direction: column; gap: 28px; }
  .fr::before { content: ''; position: absolute; left: 5.5em; top: 6px; bottom: 6px; width: 3px; background: var(--c-accent); border-radius: 3px; }
  .fr__item { display: grid; grid-template-columns: 5.5em 1fr; gap: 0 28px; position: relative; }
  .fr__item::before { content: ''; position: absolute; left: calc(5.5em - 6px); top: 8px; width: 15px; height: 15px; border-radius: 50%; background: var(--c-primary); border: 3px solid var(--c-accent); }
  .fr__annee { margin: 0; font-family: var(--font-title); font-size: 26px; font-weight: 700; line-height: 1.1; color: var(--c-text-strong); text-align: right; padding-right: 14px; }
  .fr__corps { padding-left: 14px; display: flex; flex-direction: column; gap: 6px; }
  .fr__titre { margin: 0; font-size: var(--fs-lg, 19px); color: var(--c-text-strong); }
  .fr__texte { margin: 0; color: var(--c-text-body); }
  .fr__image :global(img) { width: 100%; max-width: 420px; height: auto; border-radius: var(--radius-md); margin-top: 6px; }
  :global(.on-dark) .fr__annee, :global(.on-dark) .fr__titre { color: #fff; }
  :global(.on-dark) .fr__texte { color: var(--c-on-dark-body); }
</style>
